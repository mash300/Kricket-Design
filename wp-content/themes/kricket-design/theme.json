{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"layout": {
			"contentSize": "720px",
			"wideSize": "1120px"
		},
		"color": {
			"defaultPalette": false,
			"palette": [
				{
					"slug": "base",
					"name": "Base",
					"color": "#ffffff"
				},
				{
					"slug": "contrast",
					"name": "Contrast",
					"color": "#17191b"
				},
				{
					"slug": "surface",
					"name": "Surface",
					"color": "#f2f3f1"
				},
				{
					"slug": "muted",
					"name": "Muted",
					"color": "#666b6f"
				},
				{
					"slug": "accent",
					"name": "Accent",
					"color": "#405a66"
				}
			]
		},
		"typography": {
			"fluid": true
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontWeight": "600",
					"lineHeight": "1.15"
				}
			},
			"link": {
				"color": {
					"text": "var:preset|color|contrast"
				}
			},
			"button": {
				"border": {
					"radius": "999px"
				},
				"color": {
					"background": "var:preset|color|contrast",
					"text": "var:preset|color|base"
				},
				"spacing": {
					"padding": {
						"top": "0.8rem",
						"right": "1.35rem",
						"bottom": "0.8rem",
						"left": "1.35rem"
					}
				},
				"typography": {
					"fontWeight": "600"
				}
			}
		}
	}
}